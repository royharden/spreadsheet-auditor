# dependencies and build output
node_modules/
dist/
coverage/
.vite/
*.tsbuildinfo

# environment: only the template is committed
.env
.env.*
!.env.example

# eval output is written by scripts/eval.ts, never committed by hand
results/*
!results/.gitkeep

# supabase local state
supabase/.temp/
supabase/.branches/

# logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Keep local credentials, private keys, and generated archives out of Git
.creds/
ArchiveManager-creds.txt
*.pem
*.key
*.p12
*.pfx
*.zip
.cache/
