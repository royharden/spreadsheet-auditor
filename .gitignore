# dependencies and build output
node_modules/
dist/
coverage/
.vite/
*.tsbuildinfo

# environment: only the template is committed
.env
.env.*
!.env.example

# eval output is written by scripts/eval.ts, never committed by hand
results/*
!results/.gitkeep

# supabase local state
supabase/.temp/
supabase/.branches/

# logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
